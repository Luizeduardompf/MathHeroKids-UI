{
  "expo": {
    "name": "Math Hero Kids",
    "slug": "math-hero-kids",
    "version": "1.0.0",
    "scheme": "mathherokids",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B52E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luizeduardompf.mathherokids"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2B52E5"
      },
      "package": "com.luizeduardompf.mathherokids",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2B52E5"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/c9e1ab66-bab6-4dbd-bdb7-990087d1f209",
      "requestHeaders": {
        "expo-channel-name": "main"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "c9e1ab66-bab6-4dbd-bdb7-990087d1f209"
      }
    },
    "owner": "luizeduardompf.lixo"
  }
}
