{
  "expo": {
    "name": "Math Hero Kids",
    "slug": "math-hero-kids",
    "version": "1.0.0",
    "scheme": "mathherokids",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B52E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathherokids.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2B52E5"
      },
      "package": "com.mathherokids.app",
      "edgeToEdgeEnabled": true
    },
"plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2B52E5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/c9e1ab66-bab6-4dbd-bdb7-990087d1f209"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "c9e1ab66-bab6-4dbd-bdb7-990087d1f209"
      }
    },
    "owner": "luizeduardompf.lixo"
  }
}
